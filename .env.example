HOST=0.0.0.0
PORT=8766
CODEX_APP_SERVER_URL=ws://127.0.0.1:8765
# Codex Web 自身配置与状态目录；默认 ${XDG_CONFIG_HOME:-~/.config}/codex-web。
# CODEX_WEB_CONFIG_DIR=/absolute/path/to/codex-web
# 沿用本机 Codex CLI 的配置目录；默认 ~/.codex。
# CODEX_HOME=/absolute/path/to/.codex
# 沿用本机 Claude Code CLI 的配置目录；默认 ~/.claude。
# CLAUDE_CONFIG_DIR=/absolute/path/to/.claude
# 可选：默认项目目录；未设置时使用当前用户的主目录。
# DEFAULT_CWD=/absolute/path/to/projects
# 可选：覆盖构建资源目录；相对路径基于启动时的工作目录。
# STATIC_DIR=client/dist

# HTTPS：两项同时指定；未指定时在 CODEX_WEB_CONFIG_DIR/tls 自动生成本机证书。
# TLS_CERT=/absolute/path/to/fullchain.pem
# TLS_KEY=/absolute/path/to/privkey.pem
# 网页会话有效天数，范围 1～90，默认 30。
# AUTH_SESSION_DAYS=30
# 系统 PAM 服务，默认 login。
# AUTH_PAM_SERVICE=login
# 可选：pamtester 的绝对路径，默认从系统 PATH 查找。
# AUTH_PAMTESTER=/usr/bin/pamtester

# 后端配置文件；未设置时使用 CODEX_WEB_CONFIG_DIR/backends.json。
# 可在网页登录后的设置中配置 Codex、Claude Code，以及 Claude Code 使用的供应商。
# CODEX_WEB_BACKENDS_FILE=/path/to/backends.json
